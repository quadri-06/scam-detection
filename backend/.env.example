# Copy this file to .env and fill in real values

# Mongo connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/scam-checker

# Port the Express server runs on
PORT=5000

# Google GenAI (Gemini) API key, used by the /api/chat route for the AI helper bot
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Safe Browsing API key for a real threat-intel check
# Get one at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_KEY=
